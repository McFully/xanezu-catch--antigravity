{
  "name": "mx-catch",
  "version": "1.5.0",
  "description": "Premium Arcade Experience",
  "main": "electron_main.js",
  "scripts": {
    "start": "electron .",
    "http-server": "npx http-server . -p 8080 -o",
    "build": "electron-builder build --win"
  },
  "keywords": [],
  "author": "Xanezu Games",
  "license": "ISC",
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "fluent-ffmpeg": "^2.1.3",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.xanezu.mxcatch",
    "productName": "Xanezu Catch",
    "copyright": "Copyright © 2026 Xanezu Games",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/favicon_frog.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Xanezu Catch",
      "installerIcon": "assets/favicon_frog.ico",
      "uninstallerIcon": "assets/favicon_frog.ico",
      "displayLanguageSelector": true,
      "installerHeaderIcon": "assets/favicon_frog.ico"
    },
    "files": [
      "**/*"
    ]
  }
}
