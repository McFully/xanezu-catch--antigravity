{
  "name": "mx-catch",
  "version": "1.5.0",
  "type": "module",
  "description": "Premium Arcade Experience",
  "main": "electron_main.js",
  "scripts": {
    "start": "electron .",
    "dev": "npx http-server . -p 3000 -c-1 --cors",
    "http-server": "npx http-server . -p 3000 -o",
    "build": "electron-builder build --win",
    "build:installer": "iscc build/installer_script.iss",
    "test": "node tests/logic.test.mjs",
    "fix:env": "powershell -ExecutionPolicy Bypass -File scripts/fix_environment.ps1"
  },
  "keywords": [],
  "author": "Xanezu Games",
  "license": "ISC",
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "fluent-ffmpeg": "^2.1.3",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.xanezu.mxcatch",
    "productName": "Xanezu Catch",
    "copyright": "Copyright © 2026 Xanezu Games",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "icon": "assets/menu/favicon_frog.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Xanezu Catch",
      "installerIcon": "assets/menu/favicon_frog.ico",
      "uninstallerIcon": "assets/menu/favicon_frog.ico",
      "displayLanguageSelector": true,
      "installerHeaderIcon": "assets/menu/favicon_frog.ico"
    },
    "files": [
      "**/*"
    ]
  }
}
